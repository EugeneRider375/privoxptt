# Окружение
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# База данных PostgreSQL
DATABASE_URL=postgresql://privox:password@localhost:5432/privoxptt

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=CHANGE_ME_super_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_secret_key_minimum_32_chars
# Год: устройство логинится один раз, дальше токен ротируется при каждом
# запуске приложения. Срок строки в БД берётся из самого токена, менять больше
# нигде не надо.
REFRESH_TOKEN_EXPIRES_IN=365d

# MediaSoup WebRTC
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=YOUR_SERVER_IP_HERE
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
MEDIASOUP_NUM_WORKERS=1

# CORS — разрешённые origins (через запятую)
CORS_ORIGINS=http://localhost:5173,https://ptt.privox.tech

# Privox Monitor — Telegram-бот алармов. Токен из @BotFather, chat_id получателя.
# Если пусто — Telegram-уведомления просто отключены (no-op). В проде хранить в Coolify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Push notifications. Store the one-line Firebase service account JSON in Coolify.
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# Первый суперадмин (используется при seed)
SUPERADMIN_EMAIL=admin@privox.tech
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
SUPERADMIN_CALLSIGN=ALPHA-0
# Public HTTPS address used by Android call notifications to report
# ANSWER / DECLINE back to the server.
SERVICE_URL_WEB=http://localhost:5173
