generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // Короткое имя (privox, techtrans...)
  description String?
  logoUrl     String?
  telegramChatId String? // Telegram chat/group id for this account's sensor alerts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  groups       Group[]
  activityLogs ActivityLog[]
  messages     Message[]
  sensors      Sensor[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String // bcrypt hash
  callsign    String // Позывной (ALPHA-1, ДИСПЕТЧЕР-2)
  displayName String
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  groupMembers     GroupMember[]
  refreshTokens    RefreshToken[]
  activityLogs     ActivityLog[]
  devices          Device[]
  sentMessages     Message[]      @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageRecipient")
  messageReads     MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastSeen  DateTime?

  // Для push уведомлений (Этап 3)
  deviceToken String?
  deviceType  DeviceType?

  @@index([organizationId])
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String         @unique
  deviceName String?
  appVersion String?
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, enabled])
  @@index([platform, enabled])
}

model ActivityLog {
  id             String          @id @default(uuid())
  type           ActivityLogType
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  callsign       String
  displayName    String
  createdAt      DateTime        @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Group {
  id             String        @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        GroupMember[]
  messages       Message[]
  sensors        Sensor[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isPrivate      Boolean       @default(false)
  // Приоритет группы (выше = важнее, каналы экстренной связи)
  priority       Int           @default(0)
  // Цвет для UI
  color          String        @default("#3DDC84")

  @@index([organizationId])
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  canSpeak Boolean  @default(true) // false = только слушатель

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String?
  recipient      User?         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body           String
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  attachmentPath String?
  createdAt      DateTime      @default(now())
  reads          MessageRead[]

  @@index([organizationId, createdAt])
  @@index([groupId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model MessageRead {
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, readAt])
}

// Внешний датчик (Frigo, HomeClimate), который сервер опрашивает по HTTP.
// Прошивки и бэкенды датчиков НЕ трогаются — мы только тянем их публичные API.
model Sensor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  kind       SensorKind // FRIDGE | OUTDOOR | INDOOR | ...
  ingest     SensorIngest @default(PULL) // PULL (поллинг адаптером) | PUSH (устройство шлёт само)
  adapter    SensorAdapter? // только для PULL — как парсить ответ источника
  sourceUrl  String? // только для PULL — откуда тянем
  externalId String? // для HomeClimate: "1"/"2" (sensor_id)
  sensorKey  String?       @unique // только для PUSH — ключ устройства для /api/telemetry

  // Пороги = массив ПРАВИЛ: [{ metric, op, value|min|max, severity, sustainedSec }]
  thresholds Json
  lat        Float? // для маркера на карте
  lng        Float?

  groupId String? // в какую группу слать тревоги/push
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Здоровье устройства
  reportIntervalSec Int? // ожидаемый интервал отчёта (null = событийный, как дверь)
  batteryPct        Float?
  rssi              Int?

  lastValue  Json? // последние метрики { temperature, humidity, waterLevel, leak, ... }
  lastSeenAt DateTime? // время последнего показания
  status     SensorStatus @default(STALE) // OK | ALERT | STALE
  enabled    Boolean      @default(true)
  armed      Boolean      @default(true) // на охране: false = телеметрия пишется, но алерты/инциденты/пуши подавляются
  alarmSound Boolean      @default(false) // играть ли звуковую сирену диспетчеру при тревоге (per-sensor)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  readings  SensorReading[]
  incidents Incident[]

  @@index([organizationId, enabled])
}

model SensorReading {
  id          String   @id @default(uuid())
  sensorId    String
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  metrics     Json? // обобщённые метрики { temperature, humidity, waterLevel, leak, ... }
  temperature Float? // legacy (back-compat); дублирует metrics.temperature
  humidity    Float? // legacy
  raw         Json? // полный ответ источника
  createdAt   DateTime @default(now())

  @@index([sensorId, createdAt])
}

// Тревога с жизненным циклом: открыта → подтверждена → решена / заглушена.
model Incident {
  id        String         @id @default(uuid())
  sensorId  String
  sensor    Sensor         @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  ruleId    String? // id правила из Sensor.thresholds
  metric    String? // какая метрика сработала
  severity  AlertSeverity
  status    IncidentStatus @default(OPEN)
  message   String
  peakValue Float? // пиковое значение за время инцидента

  openedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String? // userId подтвердившего
  resolvedAt     DateTime?
  lastNotifiedAt DateTime? // для повтор-нотификации

  @@index([sensorId, status])
  @@index([status, severity])
}

enum UserRole {
  SUPERADMIN // Владелец всей системы — видит всё
  ADMIN // Администратор организации
  DISPATCHER // Диспетчер — видит всё, говорит в любую группу
  USER // Обычный пользователь рации
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum ActivityLogType {
  USER_ONLINE
  USER_OFFLINE
}

enum SensorKind {
  FRIDGE
  OUTDOOR
  INDOOR
}

enum SensorAdapter {
  FRIGO
  HOMECLIMATE
}

enum SensorIngest {
  PULL // сервер опрашивает источник адаптером
  PUSH // устройство шлёт само на /api/telemetry
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  MUTED
}

enum SensorStatus {
  OK
  ALERT
  STALE
}
