generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // Короткое имя (privox, techtrans...)
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  groups       Group[]
  activityLogs ActivityLog[]
  messages     Message[]
  sensors      Sensor[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String // bcrypt hash
  callsign    String // Позывной (ALPHA-1, ДИСПЕТЧЕР-2)
  displayName String
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  groupMembers     GroupMember[]
  refreshTokens    RefreshToken[]
  activityLogs     ActivityLog[]
  devices          Device[]
  sentMessages     Message[]      @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageRecipient")
  messageReads     MessageRead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastSeen  DateTime?

  // Для push уведомлений (Этап 3)
  deviceToken String?
  deviceType  DeviceType?

  @@index([organizationId])
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String         @unique
  deviceName String?
  appVersion String?
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, enabled])
  @@index([platform, enabled])
}

model ActivityLog {
  id             String          @id @default(uuid())
  type           ActivityLogType
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  callsign       String
  displayName    String
  createdAt      DateTime        @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Group {
  id             String        @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        GroupMember[]
  messages       Message[]
  sensors        Sensor[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isPrivate      Boolean       @default(false)
  // Приоритет группы (выше = важнее, каналы экстренной связи)
  priority       Int           @default(0)
  // Цвет для UI
  color          String        @default("#3DDC84")

  @@index([organizationId])
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  canSpeak Boolean  @default(true) // false = только слушатель

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String?
  recipient      User?         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body           String
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  attachmentPath String?
  createdAt      DateTime      @default(now())
  reads          MessageRead[]

  @@index([organizationId, createdAt])
  @@index([groupId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model MessageRead {
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, readAt])
}

// Внешний датчик (Frigo, HomeClimate), который сервер опрашивает по HTTP.
// Прошивки и бэкенды датчиков НЕ трогаются — мы только тянем их публичные API.
model Sensor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String // "Холодильник", "Улица", "Дом"
  kind       SensorKind // FRIDGE | OUTDOOR | INDOOR
  adapter    SensorAdapter // как парсить ответ источника
  sourceUrl  String // откуда тянем (frigo.privox.tech/api/stats)
  externalId String? // для HomeClimate: "1" или "2" (sensor_id)

  thresholds Json // правила тревог: { "temperature": {"min":2,"max":8}, "humidity": {"max":70} }
  lat        Float? // для маркера на карте
  lng        Float?

  groupId String? // в какую группу слать push при тревоге
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  lastValue  Json? // последнее нормализованное значение { temperature, humidity }
  lastSeenAt DateTime? // время последнего успешного замера от источника
  status     SensorStatus @default(STALE) // OK | ALERT | STALE
  enabled    Boolean      @default(true)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  readings  SensorReading[]

  @@index([organizationId, enabled])
}

model SensorReading {
  id          String   @id @default(uuid())
  sensorId    String
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  temperature Float?
  humidity    Float?
  raw         Json? // полный ответ источника
  createdAt   DateTime @default(now())

  @@index([sensorId, createdAt])
}

enum UserRole {
  SUPERADMIN // Владелец всей системы — видит всё
  ADMIN // Администратор организации
  DISPATCHER // Диспетчер — видит всё, говорит в любую группу
  USER // Обычный пользователь рации
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum ActivityLogType {
  USER_ONLINE
  USER_OFFLINE
}

enum SensorKind {
  FRIDGE
  OUTDOOR
  INDOOR
}

enum SensorAdapter {
  FRIGO
  HOMECLIMATE
}

enum SensorStatus {
  OK
  ALERT
  STALE
}
